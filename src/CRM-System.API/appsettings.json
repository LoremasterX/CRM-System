      { "LetterGrade": "D", "MinPercentage": 60.0, "MaxPercentage": 69.99, "GradePoints": 1.0, "Description": "Passing" },
      { "LetterGrade": "F", "MinPercentage": 0.0, "MaxPercentage": 59.99, "GradePoints": 0.0, "Description": "Failing" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
