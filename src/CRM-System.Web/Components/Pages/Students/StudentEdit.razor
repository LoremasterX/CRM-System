@page "/students/{Id:int}/edit"
@inject CrmAuthStateProvider AuthStateProvider
@inject IStudentService StudentService
@inject NavigationManager Navigation

<PageTitle>Edit Student — Student CRM</PageTitle>

@{
    var access = AuthStateProvider.GetAccessContext();
}

@if (!access.IsAuthenticated || !access.IsAdmin)
{
    <EmptyStateCard Icon="🛡️" Title="Administrator Access Required" Description="Only university administrators can perform administrative edits on student records.">
        <a href="profile" class="btn btn-primary">Return to My Profile</a>
    </EmptyStateCard>
}
else if (_isLoading)
{
    <div class="crm-card p-5 text-center text-muted">Loading student record...</div>
}
else if (_notFoundMessage is not null)
{
    <EmptyStateCard Icon="🔍" Title="Student Not Found" Description="@_notFoundMessage">
        <a href="students" class="btn btn-primary">Back to Directory</a>
    </EmptyStateCard>
}
else
{
    <div class="crm-page-header">
        <div>
            <h1 class="crm-page-title">Edit Student Record</h1>
            <p class="crm-page-subtitle">Updating record for <strong>@_model.FullName</strong> (@_model.StudentNumber)</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@($"students/{Id}")" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>

    <div class="crm-card p-4 p-md-5">
        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 small">
                @foreach (var err in _errors)
                {
                    <div>• @err</div>
                }
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleUpdateAsync" FormName="EditStudentForm">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="crm-form-label">Full Name *</label>
                    <InputText class="form-control" @bind-Value="_model.FullName" />
                    <ValidationMessage For="() => _model.FullName" />
                </div>

                <div class="col-md-6">
                    <label class="crm-form-label">University Email *</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="col-md-4">
                    <label class="crm-form-label">Student ID *</label>
                    <InputText class="form-control" @bind-Value="_model.StudentNumber" />
                    <ValidationMessage For="() => _model.StudentNumber" />
                </div>

                <div class="col-md-4">
                    <label class="crm-form-label">Phone Number</label>
                    <InputText class="form-control" @bind-Value="_model.PhoneNumber" />
                    <ValidationMessage For="() => _model.PhoneNumber" />
                </div>

                <div class="col-md-4">
                    <label class="crm-form-label">Date of Birth</label>
                    <InputDate class="form-control" @bind-Value="_model.DateOfBirth" />
                    <ValidationMessage For="() => _model.DateOfBirth" />
                </div>

                <div class="col-md-6">
                    <label class="crm-form-label">University *</label>
                    <InputText class="form-control" @bind-Value="_model.University" />
                    <ValidationMessage For="() => _model.University" />
                </div>

                <div class="col-md-6">
                    <label class="crm-form-label">Faculty / School *</label>
                    <InputText class="form-control" @bind-Value="_model.Faculty" />
                    <ValidationMessage For="() => _model.Faculty" />
                </div>

                <div class="col-md-6">
                    <label class="crm-form-label">Department *</label>
                    <InputText class="form-control" @bind-Value="_model.Department" />
                    <ValidationMessage For="() => _model.Department" />
                </div>

                <div class="col-md-6">
                    <label class="crm-form-label">Study Program *</label>
                    <InputText class="form-control" @bind-Value="_model.StudyProgram" />
                    <ValidationMessage For="() => _model.StudyProgram" />
                </div>

                <div class="col-md-4">
                    <label class="crm-form-label">Study Year (1 - 6) *</label>
                    <InputNumber class="form-control" @bind-Value="_model.StudyYear" min="1" max="6" />
                    <ValidationMessage For="() => _model.StudyYear" />
                </div>

                <div class="col-md-4">
                    <label class="crm-form-label">Enrollment Date *</label>
                    <InputDate class="form-control" @bind-Value="_model.EnrollmentDate" />
                </div>

                <div class="col-md-4">
                    <label class="crm-form-label">Student Status *</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        @foreach (var st in Enum.GetValues<StudentStatus>())
                        {
                            <option value="@st">@st</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-12">
                    <label class="crm-form-label">Profile Bio &amp; Academic Notes</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_model.Bio" />
                    <ValidationMessage For="() => _model.Bio" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="@($"students/{Id}")" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4" disabled="@_isSaving">
                    @(_isSaving ? "Saving Changes..." : "Save Student Record")
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateStudentRequestDto _model = new();
    private IReadOnlyList<string> _errors = [];
    private string? _notFoundMessage;
    private bool _isLoading = true;
    private bool _isSaving;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _notFoundMessage = null;

        var access = AuthStateProvider.GetAccessContext();
        if (!access.IsAdmin)
        {
            _isLoading = false;
            return;
        }

        var result = await StudentService.GetStudentByIdAsync(Id, access);
        if (!result.Succeeded || result.Data is null)
        {
            _notFoundMessage = result.Message ?? "Student record was not found.";
        }
        else
        {
            var s = result.Data;
            _model = new UpdateStudentRequestDto
            {
                FullName = s.FullName,
                Email = s.Email,
                StudentNumber = s.StudentNumber,
                PhoneNumber = s.PhoneNumber,
                DateOfBirth = s.DateOfBirth,
                University = s.University,
                Faculty = s.Faculty,
                Department = s.Department,
                StudyProgram = s.StudyProgram,
                StudyYear = s.StudyYear,
                Bio = s.Bio,
                Status = s.Status,
                EnrollmentDate = s.EnrollmentDate
            };
        }

        _isLoading = false;
    }

    private async Task HandleUpdateAsync()
    {
        _isSaving = true;
        _errors = [];

        try
        {
            var access = AuthStateProvider.GetAccessContext();
            var result = await StudentService.UpdateStudentAsync(Id, _model, access);
            if (!result.Succeeded)
            {
                _errors = result.Errors.Count > 0 ? result.Errors : [result.Message ?? "Failed to update student record."];
                return;
            }

            Navigation.NavigateTo($"students/{Id}");
        }
        finally
        {
            _isSaving = false;
        }
    }
}
