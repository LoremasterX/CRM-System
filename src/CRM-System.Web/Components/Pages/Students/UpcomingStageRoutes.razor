@page "/tasks"
@page "/calendar"
@page "/notifications"
@inject NavigationManager Navigation

<PageTitle>@GetModuleTitle() — Student CRM</PageTitle>

<div class="crm-page-header">
    <div>
        <h1 class="crm-page-title">@GetModuleTitle()</h1>
        <p class="crm-page-subtitle">Stage 3: Tasks &amp; Notifications • Planned Sequential Delivery Module</p>
    </div>
    <a href="" class="btn btn-outline-primary">← Back to Dashboard</a>
</div>

<EmptyStateCard Icon="🚀"
                Title="@($"{GetModuleTitle()} (Stage 3: Tasks & Notifications)")"
                Description="This module is part of Stage 3 (03_Tasks_Notifications.zip) and will provide student task management, overdue calculation, academic calendar events, and persisted in-app notifications.">
    <a href="courses" class="btn btn-primary">Explore Courses</a>
    <a href="" class="btn btn-outline-secondary">Return to Dashboard</a>
</EmptyStateCard>

@code {
    private string GetCurrentSegment() =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private string GetModuleTitle() => GetCurrentSegment() switch
    {
        "tasks" => "Student Tasks & Deadlines",
        "calendar" => "Academic Calendar",
        "notifications" => "Notifications Center",
        _ => "Productivity Module"
    };
}
